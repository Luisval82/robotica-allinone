# Copia este archivo como .env.local (en tu ordenador) y define las mismas
# variables en Vercel → Settings → Environment Variables.

# Clave con la que se firma la cookie de sesión. Pon un texto largo y aleatorio.
# Puedes generar uno con:  openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL de tu proyecto de Supabase (Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Secret key (empieza por sb_secret_...). Es la que usa el servidor para
# TODAS las consultas: salta las políticas de RLS igual que antes hacía la
# clave service_role. NUNCA la pongas en una variable NEXT_PUBLIC_ ni la
# subas a un repositorio público.
SUPABASE_SECRET_KEY=sb_secret_cambia-esto-por-la-tuya

# Publishable key (empieza por sb_publishable_...). Esta aplicación no hace
# ninguna consulta desde el navegador, así que no es imprescindible, pero
# puedes dejarla definida por si algún día hace falta desde un componente
# de cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cambia-esto-por-la-tuya

# ── Entrar con la cuenta de Google del colegio ──────────────────────────
# Credenciales del ID de cliente de OAuth (Google Cloud Console → APIs y
# servicios → Credenciales → Aplicación web). En «URIs de redireccionamiento
# autorizados» hay que poner:
#   https://TU-DOMINIO/acceso/google/callback
# Mientras falten estas dos variables, el botón de Google no se enseña.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Quién entra ya como docente ─────────────────────────────────────────
# Correos del colegio que entran con su rol desde la primera vez, sin que
# nadie se lo tenga que dar a mano. Separados por comas.
# Mientras un correo esté en estas listas recupera ese rol cada vez que
# entra, así que para degradar a alguien hay que quitarlo de aquí primero.
SUPERADMIN_EMAILS=
PROFESOR_EMAILS=
